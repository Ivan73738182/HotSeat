<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Верхняя панель: сумма и прогресс -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnTakeMoney"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_answer"
            android:text="@string/take_money"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:paddingHorizontal="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_orange"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="8dp">

            <TextView
                android:id="@+id/tvPrize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 000 ₽"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 / 15"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- Вопрос -->
    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:minHeight="100dp"
        android:text="Какого цвета кожа белого медведя?"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Панель подсказок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn5050"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_answer"
            android:text="@string/help_5050"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_answer"
            android:text="@string/help_call"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_answer"
            android:text="@string/help_audience"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_answer"
            android:text="@string/help_switch"
            android:textColor="@color/text_white"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Варианты ответов -->
    <Button
        android:id="@+id/btnA"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_answer"
        android:text="A: Белого"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp" />

    <Button
        android:id="@+id/btnB"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_answer"
        android:text="B: Розового"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp" />

    <Button
        android:id="@+id/btnC"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/btn_answer"
        android:text="C: Чёрного"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp" />

    <Button
        android:id="@+id/btnD"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/btn_answer"
        android:text="D: Зелёного"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="17sp"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="24dp" />

</LinearLayout>
